# ============================================================
# .gitignore for Next.js (TypeScript)
# ============================================================
# This file tells Git which files/folders to ignore.
# Rule of thumb: ignore anything that is auto-generated,
# environment-specific, or contains secrets.

# ─── Dependencies ───────────────────────────────────────────
# node_modules contains all installed packages.
# It's huge and fully reproducible via `npm install`.
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ─── Next.js Build Output ───────────────────────────────────
# .next/ is generated by `next build` / `next dev`.
# Never commit build artifacts — they differ per machine.
.next/
out/

# ─── Production Build ───────────────────────────────────────
# Output from `next export` (static HTML export)
/build
/dist

# ─── Environment Variables ──────────────────────────────────
# .env files may contain API keys, database URLs, secrets.
# NEVER commit these to version control.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# It's OK to commit .env.example (template without real values)
# !.env.example

# ─── Debug & Logs ───────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── TypeScript ─────────────────────────────────────────────
# TypeScript incremental build cache
*.tsbuildinfo
next-env.d.ts

# ─── Testing ────────────────────────────────────────────────
# Jest coverage reports
coverage/
.nyc_output

# ─── Linting & Formatting Cache ─────────────────────────────
.eslintcache
.stylelintcache

# ─── OS-specific Files ──────────────────────────────────────
# macOS metadata files (created by Finder)
.DS_Store
.AppleDouble
.LSOverride

# Windows thumbnail cache
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── IDE & Editor Files ─────────────────────────────────────
# VS Code workspace settings (keep launch.json, tasks.json if
# your team uses them; ignore user-specific settings)
.vscode/settings.json
.vscode/*.code-workspace

# IntelliJ / WebStorm
.idea/
*.iml
*.iws

# ─── Vercel Deployment ──────────────────────────────────────
.vercel

# ─── Turbopack / Turborepo ──────────────────────────────────
.turbo

# ─── Storybook ──────────────────────────────────────────────
storybook-static/

# ─── Misc ───────────────────────────────────────────────────
# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~
